POSTGRES_HOST_PORT=15432
POSTGRES_PASSWORD=knowtrace
DATABASE_URL=postgres://knowtrace_workflow:knowtrace@localhost:15432/knowtrace_workflow

# The embedded go-user-system backend is started by the root Compose stack.
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://localhost:8082
AUTH_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_BACKEND_PORT=8082
AUTH_APP_ENV=development
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_HOURS=168

# scripts/start-all.ps1 generates these local-only secrets in .env.
AUTH_DB_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=

# The first startup creates this administrator only when no administrator exists.
KNOWTRACE_ADMIN_USERNAME=KnowTrace-Workflow
# 留空 → scripts/init-env.sh 会**随机生成**（48 字符）。
# 想用固定值 KnowTrace-Workflow@123（仅本机开发）请显式传 --use-fixed-admin-credential / -UseFixedAdminCredential。
# 2026-10-02 实测：这里原先写着字面量 KnowTrace-Workflow@123，于是 init-env 的
# 「值为空才生成」判据**永不触发** —— 公网机器会带着 README 里公开的口令上线。
KNOWTRACE_ADMIN_PASSWORD=

# Bind to 127.0.0.1 by default. Set 0.0.0.0 only for an explicitly protected LAN.
KNOWTRACE_HOST=127.0.0.1

# mock works without an API key and is the default for local development.
AI_DEFAULT_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_INPUT_CHARS=12000
AI_RUNNING_STALE_AFTER_MS=300000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 证据图片存储（ADR-0020）-----------------------------------------------
# local        = 写本地磁盘（默认；Docker / VPS 单机，需挂载可写目录 data/uploads）
# vercel-blob  = 写 Vercel Blob；浏览器直传，绕开函数 4.5 MB 请求体上限
# 留空时：有 BLOB_READ_WRITE_TOKEN 就走 vercel-blob，否则 local。
EVIDENCE_IMAGE_STORAGE=
# 仅本地驱动使用；容器内默认 /app/data/uploads/evidence。
EVIDENCE_UPLOAD_DIR=
# Blob 存储的可见性。证据图片是用户隐私数据，默认 private（不得改为 public 除非你确认可公开）。
EVIDENCE_IMAGE_BLOB_ACCESS=private
# Vercel 上连接 Blob 存储会自动注入；自建环境需手工填。
BLOB_READ_WRITE_TOKEN=
