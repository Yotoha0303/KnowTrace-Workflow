[Unit]
Description=KnowTrace consistent application backup
Documentation=file:/opt/knowtrace/docs/15-stage2-vps-reliability.md
Requires=docker.service
After=docker.service network-online.target
ConditionPathExists=/opt/knowtrace/scripts/linux/backup-all.sh

[Service]
Type=oneshot
Environment=PROJECT_DIR=/opt/knowtrace
Environment=BACKUP_ROOT=/var/backups/knowtrace
Environment=QUIESCE_WRITES=1
Environment=RETENTION_DAYS=14
Environment=MIN_KEEP=7
UMask=0077
ExecStart=/opt/knowtrace/scripts/linux/backup-all.sh
ExecStartPost=/opt/knowtrace/scripts/linux/prune-backups.sh
ExecStartPost=-/opt/knowtrace/scripts/linux/write-backup-metrics.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
