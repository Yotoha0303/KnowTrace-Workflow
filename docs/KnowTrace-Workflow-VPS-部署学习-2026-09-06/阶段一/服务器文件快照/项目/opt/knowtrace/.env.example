POSTGRES_HOST_PORT=15432
POSTGRES_PASSWORD=knowtrace
DATABASE_URL=postgres://knowtrace:knowtrace@localhost:15432/knowtrace

# The embedded go-user-system backend is started by the root Compose stack.
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://localhost:8082
AUTH_REGISTRATION_ENABLED=false
AUTH_COOKIE_SECURE=false
AUTH_BACKEND_PORT=8082
AUTH_APP_ENV=development
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_HOURS=168

# scripts/start-all.ps1 generates these local-only secrets in .env.
AUTH_DB_ROOT_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=

# The first startup creates this administrator only when no administrator exists.
KNOWTRACE_ADMIN_USERNAME=KnowTrace
KNOWTRACE_ADMIN_PASSWORD=KnowTrace@123

# Bind to 127.0.0.1 by default. Set 0.0.0.0 only for an explicitly protected LAN.
KNOWTRACE_HOST=127.0.0.1

# mock works without an API key and is the default for local development.
AI_DEFAULT_PROVIDER=mock
AI_REQUEST_TIMEOUT_MS=90000
AI_MAX_INPUT_CHARS=12000
AI_RUNNING_STALE_AFTER_MS=300000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
