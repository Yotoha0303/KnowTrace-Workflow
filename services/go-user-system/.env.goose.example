GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://go_user_system:your_postgres_password@127.0.0.1:5432/go_user_system?sslmode=disable&timezone=UTC
GOOSE_MIGRATION_DIR=./migrations

# Windows Docker Desktop note:
# If 127.0.0.1:5432 is occupied by a local PostgreSQL process, publish the Compose
# database on another host port and point the DBSTRING at it, e.g. 15432:
# GOOSE_DBSTRING=postgres://go_user_system:your_postgres_password@127.0.0.1:15432/go_user_system?sslmode=disable&timezone=UTC
